<!-- Modal -->
<div class="modal fade" id="saveModal" tabindex="-1" role="dialog" aria-labelledby="saveModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-lg" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="saveModalLabel"><%= HCSR.transl("Save preferences") %></h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close">
          <span aria-hidden="true">&times;</span>
        </button>
      </div>
      <div class="modal-body">
        <label for="filename"><%= HCSR.transl("File name") %> *</label>
        <input type="text" class="form-control" name="filename" id="filename" placeholder="" value="">
     <!--   <label for="save_price"><%= HCSR.transl("Price") %></label>
        <input type="text" class="form-control" name="save_price" id="save_price" placeholder="???" value="">&nbsp;&euro;
     -->   <label for="notes"><%= HCSR.transl("Notes") %></label>
        <textarea type="text" class="form-control" name="notes" id="notes" rows="3">
        </textarea>
      </div>
      <div class="modal-footer mx-auto">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal"><%= HCSR.transl("Close") %></button>
        <button type="button" class="btn btn-primary" role="saveServer" data-bs-dismiss="modal"><%= HCSR.transl("Save changes") %></button>
        <button type="button" class="btn btn-primary" role="saveServer2" data-bs-dismiss="modal"><%= HCSR.transl("Save in new project") %></button>
    <!--    <button type="button" class="btn btn-primary" role="save" data-bs-dismiss="modal"><%= HCSR.transl("Export file") %></button> -->
     <!--   <button type="button" class="btn btn-primary" role="saveHtml" data-bs-dismiss="modal">Save in Html</button> -->
      </div>
    </div>
  </div>
</div>
