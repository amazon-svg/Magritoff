<table class="table table-striped table-hover" role="orders_table">
    <thead _class="thead-light">
        <tr class="h5">
            <th scope="col">#</th>
            <th scope="col"><%= HCSR.transl("Created") %></th>
            <th scope="col"><%= HCSR.transl("To pay") %></th>
            <th scope="col"><%= HCSR.transl("Status") %></th>
            <th scope="col"></th>
        </tr>
    </thead>
    <tbody _class="bg-white text-dark">
<% var i = 0;
    data.forEach(p => {
      i++; %>
        <tr
         onclick="/* sugarcrepeHL.instance(this).inspectInvoice('<%=p.id%>'); */">
            <th scope="row"><%= p.id %></th>
            <td><%= p.created %></td>
            <td><%= sugarcrepeHL.formatPrice(p.amount * 1.2) %></td>
            <td><%= p.status %></td>
            <td><button class="btn btn-primary" role="downloadInvoice" id="<%=p.id%>"><%= HCSR.transl("dowload pdf") %></button></td>
        </tr>
<% }); %>
    </tbody>
</table>