        <label for="ordername"><%= HCSR.transl("Name") %></label>
        <input type="text" class="form-control" name="ordername" id="ordername" placeholder="" value="<%= name %>">
        <label for="client_mail"><%= HCSR.transl("Client") %></label>
        <input type="text" disabled class="form-control" name="client_mail" id="client_mail" placeholder="" value="<%= client_mail %>">
        <label for="supplier_mail"><%= HCSR.transl("Supplier") %></label>
        <input type="text" disabled class="form-control" name="supplier_mail" id="supplier_mail" placeholder="" value="<%= supplier_mail %>">
        <label for="created"><%= HCSR.transl("Created") %></label>
        <input type="text" disabled class="form-control" name="created" id="created" placeholder="" value="<%= created%>">
        <label for="status"><%= HCSR.transl("Status") %></label>
        <input type="text" disabled class="form-control" name="status" id="status" placeholder="" value="<%= status%>">
        <label for="order_lines"><%= HCSR.transl("Items") %></label>
        <table class="table table-striped table-hover" id="order_lines">
            <thead class="thead-light">
                <tr>
                    <th scope="col">#</th>
                    <th scope="col"><%= HCSR.transl("Title") %></th>
                    <th scope="col"><%= HCSR.transl("Amount") %></th>
                    <th scope="col"></th>
                </tr>
            </thead>
            <tbody>
        <% var i = 0;
            sum_price = 0;
            if (Array.isArray(lines)) {
                lines.forEach(line => {
                i++; sum_price += (1 * line.amount); %>
                <tr line_id="<%=line.id%>">
                    <th scope="row"><%= line.id %></th>
                    <td><%= line.name %></td>
                    <td align="right"><%= line.amount %> &euro;</td>
                    <td role="actions"></td>
                </tr>
        <% })}; %>
                <tr>
                    <th colspan="2" style="text-align: right;"><%= HCSR.transl("Total :") %></th>
                    <th style="text-align: right;"><%= sum_price %> &euro;</td>
                    <td/>
                </tr>
            </tbody>
        </table>
<% if (locals.datalog) {%><%- datalog %><%}%>


<!-- Modal View line details -->
<div class="modal fade_inactive modal-details" id="viewLineModal" tabindex="-1" role="dialog" aria-labelledby="viewLineModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-lg" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="viewLineModalLabel"><%= HCSR.transl("Line details") %></h5>
        <button type="button" class="btn-close" onclick="$('.modal-details').modal('hide');" aria-label="Close">
          <span aria-hidden="true">&times;</span>
        </button>
      </div>
      <div class="modal-body container-fluid">
        <div class="row">
          <div class="col-6 m-2 bg-dark p-0 mx-auto" style="display: none;width: 94%;" role="3Dview-content"></div>
          <div class="col-5 m-2" role="resume-content"></div>
          <div class="col-12" role="pricerequest-content"></div>
        </div>
      </div>
      <div class="modal-footer mx-auto">
        <button type="button" class="btn btn-secondary" onclick="$('.modal-details').modal('hide');"><%= HCSR.transl("Close") %></button>
      </div>
    </div>
  </div>
</div>

<!-- Modal Get cutting files -->
<div class="modal fade_inactive modal-files" id="getFilesModal" tabindex="-1" role="dialog" aria-labelledby="getFilesModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-lg" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="getFilesModalLabel"><%= HCSR.transl("Do you agree with terms and conditions ?") %></h5>
        <button type="button" class="btn-close" onclick="$('.modal-files').modal('hide');" aria-label="Close">
          <span aria-hidden="true">&times;</span>
        </button>
      </div>
      <div class="modal-body">
        <label for="supplier_social_name"><%= HCSR.transl("Compagny name *") %></label>
        <input type="text" name="supplier_social_name" id="supplier_social_name"><br>
        <label for="supplier_address"><%= HCSR.transl("Address *") %></label>
        <input type="text" name="supplier_address" id="supplier_address"><br>
        <label for="supplier_zip"><%= HCSR.transl("Zip code *") %></label>
        <input type="text" name="supplier_zip" id="supplier_zip"><br>
        <label for="supplier_city"><%= HCSR.transl("City *") %></label>
        <input type="text" name="supplier_city" id="supplier_city"><br>
        <label for="supplier_country"><%= HCSR.transl("Country *") %></label>
        <input type="text" name="supplier_country" id="supplier_country"><br>
        <input type="checkbox" class="checkbox" name="agree" id="agree"/> <%= HCSR.transl("By check it you agree with") %> <a><%= HCSR.transl("Terms & conditions") %></a> <%= HCSR.transl("and accept to pay the amount of ~S euros to get this files.",["XXX"]) %>
      </div>
      <div class="modal-footer mx-auto">
        <button type="button" class="btn btn-secondary" onclick="$('.modal-files').modal('hide');"><%= HCSR.transl("Close") %></button>
        <button type="button" class="btn btn-primary disabled" disabled role="downloadFiles"><%= HCSR.transl("Give me files !") %></button>
      </div>
    </div>
  </div>
</div>
