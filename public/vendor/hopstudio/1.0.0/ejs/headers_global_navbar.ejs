                    <a class="nav-link"  onclick="sugarcrepeHL.instance(this).rinit({});"><%= short_title %> <span class="sr-only">(current)</span></a>
                  </li><% var i=0;
                    categories.forEach(cat => { %>
                  <li class="nav-item active sugar">
                      <a class="nav-link"  onclick="sugarcrepeHL.instance(this).selectCategory('<%= cat %>')"><% if (i == 0) { %>&gt; <% } else  { %>| <% } %><%=cat%></a>
                  </li>
                  <% i++; }) %>
                  <li class="nav-item active mr-4 sugar">
                    <button type="button" class="btn btn-primary" data-toggle="modal" role="openSaveModal" data-target="#saveModal">
                      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-device-ssd" viewBox="0 0 16 16">
  <path d="M4.75 4a.75.75 0 0 0-.75.75v3.5c0 .414.336.75.75.75h6.5a.75.75 0 0 0 .75-.75v-3.5a.75.75 0 0 0-.75-.75h-6.5ZM5 8V5h6v3H5Zm0-5.5a.5.5 0 1 1-1 0 .5.5 0 0 1 1 0Zm7 0a.5.5 0 1 1-1 0 .5.5 0 0 1 1 0ZM4.5 11a.5.5 0 1 0 0-1 .5.5 0 0 0 0 1Zm7 0a.5.5 0 1 0 0-1 .5.5 0 0 0 0 1Z"></path>
  <path d="M2 2a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V2Zm11 12V2a1 1 0 0 0-1-1H4a1 1 0 0 0-1 1v12a1 1 0 0 0 1 1v-2a1 1 0 0 1 1-1h6a1 1 0 0 1 1 1v2a1 1 0 0 0 1-1Zm-7.25 1v-2H5v2h.75Zm1.75 0v-2h-.75v2h.75Zm1.75 0v-2H8.5v2h.75ZM11 13h-.75v2H11v-2Z"></path>
</svg><span role="title" class="mx-2"><%= description %></span></button>
                  </li>
                  <li class="nav-item active sugar">
                    <button type="button" class="btn btn-primary" role="display_global_price">from&nbsp;<%= price %>&nbsp;&euro;/ex</button>
                  </li>
      `);
</script>
