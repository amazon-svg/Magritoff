            <div class="w-100">
                  <svg class="form-control" role="<%= T.role %>" kind="TextRich" xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 30' width="100%" height="100px" onclick="
                    const div = $('div[role=tatoo-text-<%= T.role %>]').find('div[role=<%= T.role %>-style]');
                    if (div.attr('style') === 'display: none;') div.attr('style','display: block;');
                    else div.attr('style','display: none;');"></svg>
            </div>
            <script type="text/javascript">
                onTatooTextChange($('div[role=tatoo-text-<%= T.role %>]'));
            </script>
