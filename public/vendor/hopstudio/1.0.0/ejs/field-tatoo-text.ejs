            <div class="btn-group" role="toolbar" aria-label="toolbar">
                <div class="btn-group" role="toolbar" aria-label="font">
                    <button type="button" class="btn btn-outline-secondary" onclick="changeFontWeight(this);">
                      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor"  viewBox="0 0 16 16">
                        <text x="8" y="15"
                                fill="grey" font-family="Helvetica" font-style="normal" font-weight="bold" font-size="16px" text-anchor="middle" alignment-baseline="baseline">B</text>
                    </svg>
                      <input type="hidden" name="<%= fid %>zzzvaluezzzfontzzzfont-weight" role="fw" value="<%= T.font["font-weight"] %>">
                    </button>
                    <button type="button" class="btn btn-outline-secondary" onclick="changeFontStyle(this);">
                      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor"  viewBox="0 0 16 16">
                        <text x="8" y="15"
                                fill="grey" font-family="Helvetica" font-style="italic" font-weight="bold" font-size="16px" text-anchor="middle" alignment-baseline="baseline">I</text>
                    </svg>
                      <input type="hidden" name="<%= fid %>zzzvaluezzzfontzzzfont-style" role="fstyle" value="<%= T.font["font-style"] %>">
                    </button>
                    <button type="button" class="btn btn-outline-secondary" onclick="changeUnderline(this);">
                      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor"  viewBox="0 0 16 16">
                        <text x="8" y="15"
                                fill="grey" font-family="Helvetica" font-style="normal" font-weight="bold" font-size="16px" 
                                text-decoration="underline"
                                text-anchor="middle" alignment-baseline="baseline">U</text>
                    </svg>
                      <input type="hidden" name="<%= fid %>zzzvaluezzzfontzzztext-decoration" role="tdeco" value="<%= T.font["text-decoration"] %>">
                    </button>
                    <label class="btn btn-outline-secondary" for="" style="margin-bottom: 0;">
                          <select style="width: 100px;" name="<%= fid %>zzzvaluezzzfontzzzfont-family" class="form-control" role="ff">
                              <% HU.WebSafeFonts.forEach(ff => { %>
                              <option value="<%= ff %>" <% if (T.font["font-family"] === ff) { %>selected<% } %>><%= ff %></option>
                              <% }); %>
                          </select>
                    </label>
                    <label class="btn btn-outline-secondary" for="" style="margin-bottom: 0;">
                          <select style="width: 70px;" name="<%= fid %>zzzvaluezzzfontzzzfont-size" class="form-control" role="fsize">
                              <% for (var fs=2;fs < 50; fs++) { %>
                              <option value="<%= fs %>px" <% if (T.font["font-size"] === `${fs}px`) { %>selected<% } %>><%= fs %> px</option>
                              <% } %>
                          </select>
                    </label>
                    <label class="btn btn-outline-secondary" for="" style="margin-bottom: 0; vertical-align: middle; padding-bottom: 0;">
                          <input 
                                id="color-selector"
                                type="text" role="fill" style="width: 40px; background-color:<%= T.fill %>;color:<%=T.fill%>" 
                                class="form-control"
                                onchange="this.style.backgroundColor = this.value;this.style.color = this.value;"
                                name="<%= fid %>zzzvaluezzzfill" data-coloris
                                placeholder="" value="<%= T.fill %>" <% if (locals.require == true) { %>required<% } %>>
                    </label>
                </div>
