    <!-- Wrapper drag&drop -->
    <div class="file-drop" data-role="image-uploader">
      <!-- Input natif (accessible), masqué visuellement -->
      <input
        name="<%= fid %>" 
        role="<%= value.role %>"
        id="uploader-f-<%= fid %>"
        type="file"
        accept="image/png, image/jpeg"
        class="visually-hidden"
        name="f"
        aria-labelledby="label-f-<%= fid %>"
      />

      <!-- Zone cliquable + drop -->
      <label id="label-f-<%= fid %>" for="uploader-f-<%= fid %>" class="file-drop-zone" tabindex="0" role="button" aria-describedby="hint-f">
        <svg aria-hidden="true" viewBox="0 0 24 24" class="file-drop-icon"><path d="M19 13v6H5v-6H3v8h18v-8h-2zM11 3v10l-3.5-3.5-1.42 1.42L12 16.34l5.92-5.92-1.42-1.42L13 13V3h-2z"/></svg>
        <div class="file-drop-text">
          <strong>Dépose ton image ici</strong> ou <span class="file-drop-link">parcourir</span>
          <div id="hint-f" class="file-drop-hint">PNG ou JPEG — max 300×300 (compression auto)</div>
        </div>
      </label>

      <!-- Aperçu (optionnel) -->
      <img role="<%= value.role %>" class="file-drop-preview" alt="Aperçu" style="display:none;" />
    </div>

