<div class="container-fluid pb-4">
<% if (schl_dis() && false) { %>
      <div class="row m-4 pb-2 d-md-block collapse text-center">
        <h3 class="text-dark" style="font-weight:750;"><%- HCSR.transl("builders_title") %></h4>
        <h5 class="text-dark" style="font-weight:500;"><%- HCSR.transl("builders_sub") %></h5>
      </div>
<%}%>
  <div class="dash-header">
<% if (false && !schl_dis()) { %>
      <div class="m-0 p-0 col-md-4 d-md-block collapse" role="carousel" style="height:100%;"></div>
<%}%>
<!--      class="m-0 pt-4 pb-5 px-sm-3 px-md-2 px-lg-5 col-sm-12 col-md-4 align-middle text-center"  -->
      <div 
          class="col-12 m-0 pt-4 pb-5 px-sm-3 px-md-2 px-lg-5 align-middle text-center" style="background-color: transparent;">
        <H3 id="dash-bienvenu" style="color:var(--logo-bg-yellow);"><%=HCSR.transl("Bienvenue sur Marguerite")%></H3>
        <div class="pt-4 pb-4 px-sm-3 px-md-2 px-lg-5" style="">
          <button role="startProjet" id="button-enter-catalog" class="btn btn-lg p-2" 
              style="_border-radius : 0rem!important;"
              title="<%=HCSR.transl('Let start !')%>">
              <div class="hopes-logo" style="height: 200px; width: 200px;"></div>
          </button>
        </div>
        <H3 id="dash-ask"><%= HCSR.transl("Que souhaitez vous faire ?") %></div>
        <H6 id="dash-browse"><%= HCSR.transl("Cliquez sur la fleur pour parcourir le catalogue") %></H6>
        <H6 id="dash-prompt"><%= HCSR.transl("Ou formulez votre demande ci-dessous") %></H6>
        <div id="dash-prompt-invite" class="px-auto">
          <input type="text" id="dash-prompt-input" placeholder="<%= HCSR.transl("Ecrivez ici ...") %>"></input>
        </div>
        <script language="javascript">
const start = document.getElementById("button-enter-catalog");
start?.addEventListener("click", (e)=>{
  e.preventDefault();
  e.stopPropagation();
  console.log(e.target);
  sugarcrepeHL.instance(e.target).selectCategory();
});

const dashInput = document.getElementById("dash-prompt-input");
const expand = document.getElementById("chat-expand");

if (dashInput && expand && window.hopes_suite && window.hopes_suite.chat && window.hopes_suite.chat.sendMessage) {
    dashInput.addEventListener("keypress", (e) => {
        if (e.key === "Enter" && dashInput.value.trim()) {
          expand.click();
          window.hopes_suite.chat.scrollToBottom();
          window.hopes_suite.chat.sendMessage(dashInput.value.trim());
          dashInput.value = "";
        }
      });
}

        </script>
<!--        <H3 id="dash-dashboard" style="color:var(--logo-bg-blue);"><%=HCSR.transl("Dashboard")%></H3> -->
      </div>
<% if (false) { %>     
      <div class="m-0 p-0 col-md-4 d-md-block collapse text-center" role="partner-map" style="height:100%;">
        <div id="map" style="height: 100%;"></div>
        <script type="text/javascript">
var map = L.map('map').setView([46.0759588, 1.0], 5);
L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
    maxZoom: 8,
    minZoom:5,
    attribution: "<h4><%= HCSR.transl('Our builders') %></h4>"
}).addTo(map);
PartnerLeaflet.initPartnerMap(map);
$(".leaflet-attribution-flag").parent().remove();
$(".leaflet-control-attribution span").remove();
        </script>
      </div>
<% } %>
<% if (false && schl_dis()) { %>
      <div class="m-0 p-0 col-md-4 d-md-block collapse text-center" role="builder_promo" style="height:100%;">
        <img class="m-2 w-75" src="<%=sugarcrepeHL.getRootImg()%>builders_logos.png"/>
      </div>
<% } %>
  </div>
</div>
<div class="bg-light p-3" role="dashboard" style="display: none;">
