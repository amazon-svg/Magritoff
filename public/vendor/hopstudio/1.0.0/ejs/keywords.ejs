<%  var keywords = []; 
    const keyws = [];
    Object.entries(response).forEach(entry => {
      const [id,obj] = entry; 
      const keys = id.split("~");
      if (Array.isArray(keys)) 
        keys.forEach(k => {if (!keyws.includes(k)) keyws.push(k)});
    });
    keywords = keywords.concat(keyws);
    keywords.forEach(k => {
      const rk = k.replace(' ','_');
       %>
                <a class="dropdown-item bg-light" keyword="<%= rk %>" onclick="
                    $(this).parent().prev()
                      .val($(this).attr('keyword'));
                    $(this).parent().prev().change();">
                  <span class="bg-light text-wrap"><%= k %></span>
                </a>
<% }); %>
