# Copiez ce fichier vers `.env.hopstudio.test.local`.
# Le fichier local est ignore par Git et ne doit jamais etre committe.

HOPSTUDIO_TEST_URL=https://sugar.clariprint.com/json.wcl
HOPSTUDIO_TEST_TENANT_ID=tenant-test-magrit
HOPSTUDIO_TEST_USER_ID=user-test-magrit
HOPSTUDIO_TEST_PROMPT=Je veux 500 depliants 2 volets A4 quadri recto verso sur papier couche demi-mat 170g

# Facultatifs : laissez les deux valeurs vides si le serveur ne les demande pas.
HOPSTUDIO_TEST_CLARIPRINT_USER=
HOPSTUDIO_TEST_CLARIPRINT_PASS=

# Facultatif : transmis dans X-CLARIPRINT-URL lorsque defini.
HOPSTUDIO_TEST_CLARIPRINT_URL=

# Facultatif : jeton Bearer HopeStudio si l'environnement de test en exige un.
HOPSTUDIO_TEST_API_TOKEN=

# Affiche la requete decodee et la reponse JSON dans le terminal.
# Les en-tetes d'authentification sont masques.
HOPSTUDIO_TEST_TRACE=1

# Active un second appel pour verifier la continuite session_id + DBK.
# Ce test consomme un appel IA supplementaire.
HOPSTUDIO_TEST_CONTINUATION=0
