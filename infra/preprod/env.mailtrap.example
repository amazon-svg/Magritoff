# Reporter ces valeurs dans .env.preprod.local sur le VPS.
# Domaine magritapp.com valide dans Mailtrap Email Sending, flux Transactional.
MAGRIT_FROM_EMAIL=Magrit <noreply@magritapp.com>
MAIL_HOST=live.smtp.mailtrap.io
MAIL_PORT=587
# false signifie STARTTLS sur 587 ; true serait TLS implicite sur 465.
MAIL_SECURE=false
MAIL_USER=api
# Remplir depuis Mailtrap > Sending Domains > Integrations > SMTP.
# Ne pas generer cette valeur, ne pas la commiter et ne pas l'afficher.
MAIL_PASSWORD=
