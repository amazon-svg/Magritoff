# Copier vers .env.preprod.local (ignore par Git), chmod 600.
# Generer chaque secret separement avec openssl rand -hex 32.
POSTGRES_PASSWORD=
API_DATABASE_PASSWORD=
WORKER_DATABASE_PASSWORD=
MAGRIT_AUTH_SECRET=
MAGRIT_RATE_LIMIT_IP_HMAC_SECRET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

APP_BASE_URL=https://preprod.magritapp.com
# Endpoint public necessaire aux URL signees : vhost Apache separe, sans prefixe.
S3_ENDPOINT=https://fichiers-magritt.clariprint.fr
S3_PUBLIC_BASE_URL=https://fichiers-magritt.clariprint.fr
MAGRIT_FROM_EMAIL=Magrit <noreply@magritapp.com>
# Mailpit capture les emails de demo, sans envoi vers des destinataires reels.
# Son interface reste locale au VPS, accessible par tunnel SSH sur 18025.
# Pour l'envoi reel, utiliser les valeurs de env.mailtrap.example.
MAIL_HOST=mail
MAIL_PORT=1025
MAIL_SECURE=false
MAGRIT_API_LOCAL_PORT=18787
MAGRIT_WEB_LOCAL_PORT=18080
MAGRIT_S3_LOCAL_PORT=18333
MAGRIT_MAIL_LOCAL_PORT=18025
# Adapter apres verification des reseaux Docker et de l'adresse du proxy.
MAGRIT_DOCKER_SUBNET=172.29.80.0/24
MAGRIT_TRUSTED_PROXIES=172.29.80.1/32
