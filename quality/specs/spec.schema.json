{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://magrit.local/schemas/functional-spec-1.0.json",
  "title": "Spécification fonctionnelle Magrit",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "title",
    "status",
    "revision",
    "source",
    "scope",
    "summary",
    "personas",
    "acceptanceCriteria"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "id": {
      "$ref": "#/$defs/stableId"
    },
    "title": {
      "type": "string",
      "minLength": 3
    },
    "status": {
      "enum": ["draft", "review", "approved", "deprecated"]
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "scope": {
      "$ref": "#/$defs/scope"
    },
    "summary": {
      "type": "string",
      "minLength": 10
    },
    "personas": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/persona"
      }
    },
    "businessRules": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/businessRule"
      },
      "default": []
    },
    "acceptanceCriteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/acceptanceCriterion"
      }
    },
    "scenarios": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/scenario"
      },
      "default": []
    },
    "openQuestions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 3
      },
      "default": []
    },
    "exemptions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/exemption"
      },
      "default": []
    }
  },
  "$defs": {
    "stableId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
      "minLength": 2,
      "maxLength": 80
    },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["system", "importedAt"],
      "properties": {
        "system": {
          "enum": ["notion", "git", "workshop", "other"]
        },
        "pageId": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "importedAt": {
          "type": "string",
          "format": "date-time"
        },
        "lastSyncedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "system": {
                "const": "notion"
              }
            },
            "required": ["system"]
          },
          "then": {
            "properties": {
              "pageId": true,
              "url": true,
              "lastSyncedAt": true
            },
            "required": ["pageId", "url", "lastSyncedAt"]
          }
        }
      ]
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["modules", "surfaces"],
      "properties": {
        "epic": {
          "type": "string",
          "minLength": 1
        },
        "modules": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          }
        },
        "surfaces": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "storefront",
              "customer-portal",
              "workspace",
              "backoffice",
              "api",
              "database",
              "cross-cutting"
            ]
          }
        }
      }
    },
    "persona": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "goal"],
      "properties": {
        "id": {
          "$ref": "#/$defs/stableId"
        },
        "name": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "goal": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "permissions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        }
      }
    },
    "businessRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description", "status"],
      "properties": {
        "id": {
          "$ref": "#/$defs/stableId"
        },
        "description": {
          "type": "string",
          "minLength": 5
        },
        "status": {
          "enum": ["active", "deprecated"]
        },
        "references": {
          "$ref": "#/$defs/references"
        }
      }
    },
    "acceptanceCriterion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description", "priority", "status", "verification"],
      "properties": {
        "id": {
          "$ref": "#/$defs/stableId"
        },
        "description": {
          "type": "string",
          "minLength": 5
        },
        "priority": {
          "enum": ["critical", "major", "minor"]
        },
        "status": {
          "enum": ["active", "deprecated"]
        },
        "verification": {
          "type": "object",
          "additionalProperties": false,
          "required": ["methods", "references"],
          "properties": {
            "methods": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "unit-test",
                  "contract-test",
                  "integration-test",
                  "sql-test",
                  "e2e-test",
                  "automated-test",
                  "manual",
                  "agent-review"
                ]
              }
            },
            "references": {
              "$ref": "#/$defs/references"
            }
          }
        }
      }
    },
    "references": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "kind",
        "persona",
        "execution",
        "linkedCriteria",
        "preconditions",
        "steps"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/stableId"
        },
        "title": {
          "type": "string",
          "minLength": 3
        },
        "kind": {
          "enum": ["nominal", "error", "edge", "security", "accessibility"]
        },
        "persona": {
          "$ref": "#/$defs/stableId"
        },
        "execution": {
          "enum": ["human", "browser-agent", "api", "sql", "automated-test"]
        },
        "linkedCriteria": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/stableId"
          }
        },
        "preconditions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        },
        "startUrl": {
          "type": "string",
          "minLength": 1
        },
        "testData": {
          "type": "object",
          "additionalProperties": true
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["action", "expected"],
            "properties": {
              "action": {
                "$ref": "#/$defs/nonEmptyString"
              },
              "expected": {
                "$ref": "#/$defs/nonEmptyString"
              }
            }
          }
        },
        "hints": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "testIds": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/nonEmptyString"
              }
            },
            "dom": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/nonEmptyString"
              }
            }
          }
        }
      }
    },
    "exemption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description", "owner", "expiresAt"],
      "properties": {
        "id": {
          "$ref": "#/$defs/stableId"
        },
        "description": {
          "type": "string",
          "minLength": 5
        },
        "owner": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "expiresAt": {
          "type": "string",
          "format": "date"
        },
        "remediation": {
          "type": "string",
          "minLength": 5
        }
      }
    }
  }
}
