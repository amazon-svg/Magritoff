# Copier ce fichier vers .env.quality.local. Ce dernier est ignoré par Git.

# Endpoint OpenAI ou API compatible. Ne pas ajouter /responses ni
# /chat/completions : le runner ajoute lui-même le chemin final.
QUALITY_LLM_BASE_URL=https://api.openai.com/v1
QUALITY_LLM_MODEL=YOUR_MODEL_ID
QUALITY_LLM_API=responses
QUALITY_LLM_API_KEY=YOUR_API_KEY

# Garde-fous facultatifs pour les audits volumineux.
QUALITY_LLM_BATCH_CHARS=80000
QUALITY_LLM_MAX_BATCHES=24
QUALITY_LLM_TIMEOUT_MS=180000

# Exemple local compatible Chat Completions (Ollama ou équivalent) :
# QUALITY_LLM_BASE_URL=http://localhost:11434/v1
# QUALITY_LLM_MODEL=YOUR_LOCAL_MODEL_ID
# QUALITY_LLM_API=chat-completions
# QUALITY_LLM_API_KEY=
