# Vite relaie les appels same-origin /api/v1 vers l API Node locale.
VITE_API_PROXY_TARGET=http://127.0.0.1:8787

# Fournisseur IA serveur : anthropic | openai | mistral.
# Utilise par le chat, les suggestions catalogue, le PIM et l'éditorial.
# Exemple OpenAI : MAGRIT_AI_PROVIDER=openai + OPENAI_API_KEY.
MAGRIT_AI_PROVIDER=anthropic
# MAGRIT_AI_MODEL=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# MISTRAL_API_KEY=

# Cle AES-256 (base64url ou 64 caracteres hexadecimaux) utilisee uniquement
# par l API Node pour chiffrer les identifiants Clariprint propres aux tenants.
# HOPSTUDIO_CONFIG_ENCRYPTION_KEY=
