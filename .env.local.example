# Les trois variables Supabase sont générées automatiquement avec
# `pnpm supabase:use:local` ou `pnpm supabase:use:official`.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=<local-anon-key>
VITE_API_PROXY_TARGET=http://127.0.0.1:54321/functions/v1/magrit-api

# Mode de transition hors Supabase (opt-in tant que tous les domaines ne sont
# pas migres). Demarrer `pnpm api:dev`, puis remplacer les deux valeurs :
# VITE_API_PROXY_TARGET=http://127.0.0.1:8787

# Fournisseur IA serveur : anthropic | openai | mistral.
# Utilise par le chat, les suggestions catalogue, le PIM et l'éditorial.
# Exemple OpenAI : MAGRIT_AI_PROVIDER=openai + OPENAI_API_KEY.
MAGRIT_AI_PROVIDER=anthropic
# MAGRIT_AI_MODEL=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# MISTRAL_API_KEY=
