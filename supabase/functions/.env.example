# Secrets lus côté Edge Runtime local. Ne jamais préfixer ces valeurs par VITE_.
RESEND_API_KEY=
MAGRIT_FROM_EMAIL=Magrit <onboarding@resend.dev>

# Fournisseur IA serveur : anthropic | openai | mistral
MAGRIT_AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
MISTRAL_API_KEY=

# Clé AES-256 (32 octets encodés en base64url ou 64 caractères hexadécimaux)
# utilisée uniquement côté serveur pour les mots de passe Clariprint par tenant.
HOPSTUDIO_CONFIG_ENCRYPTION_KEY=
